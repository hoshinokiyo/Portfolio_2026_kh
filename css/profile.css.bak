* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: #f5f6f8;
  color: #2f3440;
  font-family: "Hiragino Kaku Gothic ProN", "Yu Gothic", "Meiryo", sans-serif;
  line-height: 1.5;
}

.material-symbols-outlined {
  font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}

.page {
  padding: 24px 16px 40px;
}

.top-nav {
  color: #5e6470;
  display: flex;
  font-size: 13px;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  margin: 0 auto 16px;
  max-width: 1200px;
  flex-wrap: wrap;
}

.top-nav-breadcrumbs {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.top-nav-breadcrumbs a {
  color: #2563eb;
  text-decoration: none;
  transition: color 0.2s ease, text-decoration-color 0.2s ease;
}

.top-nav-breadcrumbs a:hover {
  color: #1d4ed8;
  text-decoration: underline;
}

.top-nav-breadcrumbs span {
  color: #5e6470;
}

.top-nav-current {
  color: #2f3440;
  font-weight: 700;
}

.top-nav-logout {
  align-items: center;
  background: #eaf6ff;
  border-radius: 999px;
  color: #2563eb;
  display: inline-flex;
  gap: 6px;
  padding: 6px 12px;
  text-decoration: none;
  transition: background 0.2s ease, color 0.2s ease;
}

.top-nav-logout:hover {
  background: #dceeff;
}

.top-nav-logout .material-symbols-outlined {
  font-size: 14px;
  line-height: 1;
}

.title {
  font-size: 28px;
  font-weight: 700;
  margin: 0 auto 24px;
  max-width: 1200px;
}

.page-lead {
  color: #5e6470;
  font-size: 14px;
  margin: -12px auto 24px;
  max-width: 1200px;
}

.container {
  margin: 0 auto;
  max-width: 1200px;
}

.section {
  background: #ffffff;
  border: 1px solid #d9dee7;
  border-radius: 12px;
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);
  margin-bottom: 20px;
  min-height: 220px;
  padding: 24px;
}

.section h2 {
  font-size: 20px;
  font-weight: 700;
}

.section-lead {
  color: #5e6470;
  font-size: 13px;
  margin-top: 6px;
}

.site-block {
  margin-top: 16px;
}

.site-name {
  font-weight: 700;
  margin-bottom: 8px;
}

.site-stats {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.stat {
  background: #f1f3f7;
  border: 1px solid #d9dee7;
  border-radius: 8px;
  cursor: pointer;
  padding: 6px 10px;
  font-size: 13px;
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}

.stat:hover {
  background: #eef2ff;
  border-color: #2563eb;
  transform: translateY(-1px);
}

.stat:focus-visible {
  outline: 2px solid #f59e0b;
  outline-offset: 2px;
}

.calendar-months {
  display: grid;
  gap: 16px;
  grid-template-columns: 1fr;
  margin-top: 16px;
}

.month-calendar {
  margin-top: 0;
}

.month-title {
  font-size: 16px;
  font-weight: 700;
  margin-bottom: 12px;
}

.week-row {
  color: #5e6470;
  display: grid;
  font-size: 12px;
  font-weight: 700;
  gap: 6px;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 6px;
  text-align: center;
}

.day-grid {
  display: grid;
  gap: 6px;
  grid-template-columns: repeat(7, 1fr);
}

.day {
  align-items: flex-start;
  background: #f8fafc;
  border: 1px solid #d9dee7;
  border-radius: 8px;
  display: flex;
  flex-direction: column;
  font-size: 12px;
  font-weight: 700;
  gap: 4px;
  justify-content: flex-start;
  min-height: 56px;
  padding: 8px;
}

.day-number {
  font-weight: 700;
}

.event-count {
  background: #eef2ff;
  border-radius: 999px;
  color: #2563eb;
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  padding: 2px 6px;
}

.day.muted {
  background: #f1f3f7;
  color: #a0a6b2;
}

.day.today {
  border: 2px solid #f59e0b;
  background: #fff7ed;
}

.current-month {
  border-radius: 10px;
}

.upcoming {
  border-top: 1px solid #d9dee7;
  margin-top: 20px;
  padding-top: 20px;
}

.upcoming h3 {
  font-size: 16px;
  margin-bottom: 12px;
}

.upcoming-list {
  display: grid;
  gap: 10px;
}

.upcoming-item {
  background: #f8fafc;
  border: 1px solid #d9dee7;
  border-radius: 10px;
  cursor: pointer;
  padding: 12px;
  transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}

.upcoming-item:hover {
  background: #eef2ff;
  border-color: #2563eb;
  transform: translateY(-1px);
}

.upcoming-item:focus-visible {
  outline: 2px solid #f59e0b;
  outline-offset: 2px;
}

.upcoming-label {
  color: #5e6470;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 4px;
}

.upcoming-detail {
  font-size: 13px;
  font-weight: 700;
}

@media (min-width: 768px) {
  .page {
    padding: 32px 24px 48px;
  }
}

@media (min-width: 900px) {
  .calendar-months {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 480px) {
  .week-row,
  .day-grid {
    gap: 4px;
  }

  .day {
    min-height: 44px;
    padding: 6px;
    font-size: 11px;
  }

  .ai-card {
    flex-basis: 92%;
    min-width: 92%;
    max-width: 92%;
  }

  .match-slider-button {
    width: 30px;
    height: 30px;
  }
}

@media (max-width: 1024px) and (min-width: 481px) {
  .ai-card {
    flex-basis: 46%;
    min-width: 280px;
    max-width: 320px;
  }
}

.ai-list {
  display: flex;
  gap: 16px;
  margin-top: 16px;
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  padding: 0 2px 10px;
  scroll-snap-type: x proximity;
  scrollbar-width: thin;
  scrollbar-color: #d1d5db transparent;
  box-sizing: border-box;
}

.ai-card {
  background: #f8fafc;
  border: 1px solid #d9dee7;
  border-radius: 10px;
  flex: 0 0 clamp(280px, 31%, 320px);
  min-width: 280px;
  max-width: 320px;
  padding: 16px;
  scroll-snap-align: start;
  box-sizing: border-box;
}

.ai-card-special {
  position: relative;
  overflow: hidden;
  cursor: pointer;
}

.match-slider-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.match-slider-controls {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.match-slider-button {
  width: 32px;
  height: 32px;
  border-radius: 999px;
  border: 1px solid #e5e7eb;
  background: #ffffff;
  color: #3b82f6;
  font-size: 14px;
  font-weight: 700;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
}

.match-slider-button:hover {
  background: #eef2ff;
  color: #2563eb;
}

.match-slider-button:focus-visible {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
}

.match-slider {
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  box-sizing: border-box;
}

.match-slider-track {
  width: 100%;
  max-width: 100%;
}

.ai-card-featured {
  background:
    radial-gradient(circle at 92% 10%, rgba(251, 191, 36, 0.2), transparent 32%),
    linear-gradient(180deg, #eef2ff 0%, #ffffff 34%);
  border-color: #e5e7eb;
  box-shadow: 0 8px 20px rgba(37, 99, 235, 0.1);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.ai-card-featured:hover {
  border-color: #3b82f6;
  box-shadow: 0 14px 30px rgba(37, 99, 235, 0.2);
  transform: translateY(-4px);
}

.ai-card-special-label {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  min-height: 26px;
  padding: 0 10px;
  border-radius: 999px;
  background: rgba(59, 130, 246, 0.88);
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.01em;
  box-shadow: 0 8px 18px rgba(59, 130, 246, 0.18);
  backdrop-filter: blur(8px);
  transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
}

.ai-card-special:not(.is-clone):hover,
.ai-card-special:not(.is-clone):focus-visible {
  border-color: #60a5fa;
  box-shadow: 0 16px 32px rgba(37, 99, 235, 0.22);
  transform: translateY(-6px);
}

.ai-card-special:not(.is-clone):hover .ai-card-special-label,
.ai-card-special:not(.is-clone):focus-visible .ai-card-special-label {
  background: rgba(59, 130, 246, 0.96);
  box-shadow: 0 10px 22px rgba(59, 130, 246, 0.24);
  transform: translateY(-1px);
}

.ai-card-special:focus-visible {
  outline: 2px solid #60a5fa;
  outline-offset: 3px;
}

.ai-card-image {
  width: 100%;
  height: 148px;
  object-fit: cover;
  object-position: center 30%;
  border-radius: 10px;
  margin-bottom: 12px;
  display: block;
  border: 1px solid #d1d5db;
  transition: transform 0.28s ease, filter 0.28s ease;
}

.ai-card-special:not(.is-clone):hover .ai-card-image,
.ai-card-special:not(.is-clone):focus-visible .ai-card-image {
  transform: scale(1.02);
  filter: saturate(1.02);
}

.ai-image-analysis {
  object-position: center 22%;
}

.ai-image-card2 {
  object-position: center 34%;
}

.ai-image-card3 {
  object-position: center 34%;
}

.ai-image-card4 {
  object-position: center 34%;
}

.ai-image-card5 {
  object-position: center 24%;
}

.ai-image-card6 {
  object-position: center 28%;
}

.ai-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  border-radius: 999px;
  background: rgba(251, 191, 36, 0.2);
  color: #f59e0b;
  font-size: 11px;
  font-weight: 700;
  margin-bottom: 10px;
}

.ai-badge::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 999px;
  background: #f472b6;
}

.ai-feature-head {
  font-size: 13px;
  font-weight: 700;
  color: #1f2937;
  margin: 12px 0 6px;
  padding-left: 10px;
  border-left: 2px solid #f472b6;
}

.ai-points {
  margin: 0 0 10px;
  padding-left: 18px;
  display: grid;
  gap: 7px;
  font-size: 13px;
  color: #1f2937;
}

.ai-title {
  font-size: 15px;
  font-weight: 800;
  color: #1f2937;
  margin-bottom: 10px;
}

.ai-copy {
  font-size: 13px;
  color: #6b7280;
  line-height: 1.7;
  margin-bottom: 12px;
}

.ai-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.ai-tags span {
  background: #eef2f7;
  border-radius: 6px;
  font-size: 12px;
  padding: 4px 8px;
}

.ai-card-featured .ai-tags {
  margin-bottom: 12px;
}

.match-card-link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 2px;
  color: #3b82f6;
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
  background: transparent;
  border: 0;
  padding: 0;
  cursor: pointer;
}

.match-card-link-primary {
  gap: 6px;
  color: #2563eb;
  text-decoration: underline;
  text-decoration-color: rgba(37, 99, 235, 0.34);
  text-underline-offset: 0.18em;
  transition:
    color 0.2s ease,
    text-decoration-color 0.2s ease,
    text-underline-offset 0.2s ease,
    opacity 0.2s ease;
}

.match-card-link:hover {
  color: #2563eb;
  text-decoration: underline;
}

.ai-card-special:not(.is-clone):hover .match-card-link-primary,
.ai-card-special:not(.is-clone):focus-visible .match-card-link-primary,
.match-card-link-primary:hover,
.match-card-link-primary:focus-visible {
  color: #1d4ed8;
  text-decoration-color: rgba(29, 78, 216, 0.55);
  text-underline-offset: 0.24em;
}

.match-card-link:focus-visible {
  outline: 2px solid #3b82f6;
  outline-offset: 3px;
  border-radius: 4px;
}

.match-card-link-arrow {
  font-size: 15px;
  line-height: 1;
  transition: transform 0.2s ease;
}

.match-card-link:hover .match-card-link-arrow,
.match-card-link:focus-visible .match-card-link-arrow,
.ai-card-special:not(.is-clone):hover .match-card-link-arrow,
.ai-card-special:not(.is-clone):focus-visible .match-card-link-arrow {
  transform: translateX(4px);
}

.match-card-disabled {
  text-align: left;
}

.match-toast {
  position: fixed;
  left: 50%;
  transform: translate(-50%, 8px);
  bottom: 18px;
  z-index: 40;
  max-width: 320px;
  background: #eef2ff;
  color: #2563eb;
  border: 1px solid #d1d5db;
  border-radius: 12px;
  padding: 10px 14px;
  font-size: 12px;
  line-height: 1.5;
  box-shadow: 0 8px 18px rgba(37, 99, 235, 0.16);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease, transform 0.22s ease;
}

.match-toast.is-visible {
  opacity: 1;
  transform: translate(-50%, 0);
}

.ai-card-featured .ai-tag-calm {
  background: #eef2ff;
  color: #3b82f6;
}

.ai-card-featured .ai-tag-care {
  background: rgba(244, 114, 182, 0.14);
  color: #f472b6;
}

.ai-card-featured .ai-tag-support {
  background: rgba(251, 191, 36, 0.18);
  color: #f59e0b;
}

.ai-card-variant-b .ai-badge::before,
.ai-card-variant-b .ai-feature-head {
  border-left-color: #3b82f6;
  background: none;
}

.ai-card-variant-c .ai-badge::before,
.ai-card-variant-c .ai-feature-head {
  border-left-color: #f472b6;
  background: none;
}

.ai-card-variant-d .ai-badge::before,
.ai-card-variant-d .ai-feature-head {
  border-left-color: #f59e0b;
  background: none;
}

.ai-card-variant-b .ai-badge::before {
  background: #3b82f6;
}

.ai-card-variant-c .ai-badge::before {
  background: #f472b6;
}

.ai-card-variant-d .ai-badge::before {
  background: #f59e0b;
}

.ai-card-variant-e {
  background:
    radial-gradient(circle at 12% 12%, rgba(59, 130, 246, 0.12), transparent 38%),
    linear-gradient(180deg, #eef2ff 0%, #ffffff 36%);
}

.ai-card-variant-f {
  background:
    radial-gradient(circle at 92% 12%, rgba(244, 114, 182, 0.14), transparent 36%),
    linear-gradient(180deg, #f9fafb 0%, #ffffff 36%);
}

.ai-card-variant-e .ai-badge::before,
.ai-card-variant-e .ai-feature-head {
  border-left-color: #3b82f6;
  background: none;
}

.ai-card-variant-f .ai-badge::before,
.ai-card-variant-f .ai-feature-head {
  border-left-color: #f472b6;
  background: none;
}

.ai-card-variant-e .ai-badge::before {
  background: #3b82f6;
}

.ai-card-variant-f .ai-badge::before {
  background: #f472b6;
}

.ai-card-featured .ai-tag-b1,
.ai-card-featured .ai-tag-c1,
.ai-card-featured .ai-tag-d2 {
  background: #eef2ff;
  color: #3b82f6;
}

.ai-card-featured .ai-tag-b2,
.ai-card-featured .ai-tag-c2,
.ai-card-featured .ai-tag-d3 {
  background: rgba(244, 114, 182, 0.14);
  color: #f472b6;
}

.ai-card-featured .ai-tag-b3,
.ai-card-featured .ai-tag-c3,
.ai-card-featured .ai-tag-d1 {
  background: rgba(251, 191, 36, 0.18);
  color: #f59e0b;
}

.ai-card-featured .ai-tag-e1,
.ai-card-featured .ai-tag-f2 {
  background: #eef2ff;
  color: #3b82f6;
}

.ai-card-featured .ai-tag-e2,
.ai-card-featured .ai-tag-f1 {
  background: rgba(251, 191, 36, 0.18);
  color: #f59e0b;
}

.ai-card-featured .ai-tag-e3,
.ai-card-featured .ai-tag-f3 {
  background: rgba(244, 114, 182, 0.14);
  color: #f472b6;
}
